{
  "name": "quartz-jupyter-embed",
  "version": "1.0.0",
  "description": "Embed Jupyter notebooks in Quartz pages by linking to a .ipynb file. Locally customized fork of vazome/quartz-jupyter-embed (see README) with support for relative links to local notebooks.",
  "type": "module",
  "license": "MIT",
  "author": "vazome",
  "repository": {
    "type": "git",
    "url": "https://github.com/vazome/quartz-jupyter-embed"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "jupyter",
    "notebook",
    "ipynb",
    "embed",
    "rehype",
    "hast"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "@quartz-community/types": "^0.2.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "quartz": {
    "name": "jupyter-embed",
    "displayName": "Jupyter Notebook Embed",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 15,
    "defaultEnabled": true,
    "defaultOptions": {
      "cacheDir": ".quartz-cache/notebooks",
      "downloadFromGitHub": true,
      "downloadTimeout": 15000,
      "repoRef": "main"
    },
    "optionSchema": {
      "cacheDir": {
        "type": "string"
      },
      "downloadFromGitHub": {
        "type": "boolean"
      },
      "downloadTimeout": {
        "type": "number"
      },
      "repoUrl": {
        "type": "string"
      },
      "repoRef": {
        "type": "string"
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}
